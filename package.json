{
  "name": "today-scheduler",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "electron .",
    "web": "node server.js",
    "start": "electron .",
    "test": "node --test",
    "package:mac": "electron-builder --mac",
    "build:native": "node desktop/native/build.cjs",
    "prestart": "npm run build:native",
    "predev": "npm run build:native",
    "prepackage:mac": "npm run build:native",
    "demo": "electron . --demo",
    "predemo": "npm run build:native",
    "package:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ingjae.haru",
    "productName": "Haru",
    "files": [
      "desktop/**",
      "public/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "desktop/assets/haru.icns",
      "extraResources": [
        {
          "from": "desktop/bin/haru-layout",
          "to": "haru-layout"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "desktop/assets/haru.png",
      "artifactName": "Haru-${version}-${arch}.AppImage",
      "executableName": "haru"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "description": "A quiet macOS calendar ribbon that keeps your day in view.",
  "author": "ingjae",
  "license": "MIT",
  "homepage": "https://github.com/ingjae/haru",
  "repository": {
    "type": "git",
    "url": "https://github.com/ingjae/haru.git"
  },
  "bugs": {
    "url": "https://github.com/ingjae/haru/issues"
  },
  "keywords": [
    "macos",
    "calendar",
    "google-calendar",
    "electron",
    "widget"
  ]
}
